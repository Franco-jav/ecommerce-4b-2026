{
  "name": "Projeto",

  "build": {
    "dockerfile": "Dockerfile"
  },

  "forwardPorts": [8080, 3306],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker",      
        "vscjava.vscode-java-pack",    //Java         
        "vmware.vscode-spring-boot",   //spring boot
           
        "vscjava.vscode-spring-boot-dashboard", 
        "cweijan.vscode-mysql-client2",   //MySQL
        "vscjava.vscode-spring-initializr"  //Criacao de projeto spring boot    
      ],

      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "editor.fontSize": 14,
        "terminal.integrated.fontSize": 20,
        "java.server.launchMode": "Standard"
      }
    }
  },

  "postCreateCommand": "/bin/bash .devcontainer/init-mysql.sh",

  "postStartCommand": "service mysql start"
}
